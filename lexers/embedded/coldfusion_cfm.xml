            type="NameBuiltin"
          /></bygroups></rule>
      <rule
        pattern="(?s)(&lt;/?cf(?:component|include|if|else|elseif|loop|return|dbinfo|dump|abort|location|invoke|throw|file|savecontent|mailpart|mail|header|content|zip|image|lock|argument|try|catch|break|directory|http|set|function|param|processingdirective)\b)(.*?)((?&lt;!\\)&gt;)"
      ><bygroups><token type="NameBuiltin" /><using lexer="Coldfusion" /><token
