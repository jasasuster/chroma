          <token type="Punctuation" />
          <token type="Text" />
          <token type="Punctuation" />
          <token type="Text" />
          <token type="NameTag" />
          <token type="Text" />
          <token type="Punctuation" />
        </bygroups>
        <pop depth="1" />
      </rule>
      <rule pattern=".+?(?=&lt;\s*/\s*style\s*&gt;)">
