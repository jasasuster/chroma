      <rule><include state="tags" /></rule>
      <rule pattern="(?s)&lt;[^&lt;&gt;]*"><token type="Other" /></rule>
      <rule pattern="#"><token type="Other" /></rule>
    </state>
    <state name="cfcomment">
      <rule pattern="&lt;!---"><token type="CommentMultiline" /><push /></rule>
      <rule pattern="---&gt;"><token type="CommentMultiline" /><pop
          depth="1"
        /></rule>
      <rule pattern="([^&lt;-]|&lt;(?!!---)|-(?!--&gt;))+"><token
          type="CommentMultiline"
